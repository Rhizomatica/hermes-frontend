# =============================================================================
# HERMES Frontend — Environment Variables
# =============================================================================
# Copy this file to each app's .env.local:
#   cp .env.example apps/hermes-shell/.env.local
#   cp .env.example apps/hermes-gps-final/.env.local
#   cp .env.example apps/hermes-chat-final/.env.local
# =============================================================================

# sBitx local services (defaults for development)
HERMES_API_URL=http://localhost:8080
HERMES_RADIO_DAEMON_URL=ws://localhost:8081

# App base paths (for nginx reverse proxy — co-deployed mode)
# hermes-shell:   NEXT_PUBLIC_BASE_PATH=
# hermes-gps:     NEXT_PUBLIC_BASE_PATH=/gps
# hermes-chat:    NEXT_PUBLIC_BASE_PATH=/chat
NEXT_PUBLIC_BASE_PATH=

# Shell URL for cross-app auth redirects (dev: localhost:4000)
NEXT_PUBLIC_SHELL_URL=http://localhost:4000

# Login page path
NEXT_PUBLIC_LOGIN_URL=/login

# App version (set by CI at build time)
NEXT_PUBLIC_APP_VERSION=dev

# Timezone for date/time display
NEXT_PUBLIC_APP_TIME_ZONE=UTC

# PMTiles file path (for hermes-gps-final)
# Relative path → served from /public/. Absolute URL → local file or local network.
NEXT_PUBLIC_PMTILES_URL=/brazil.pmtiles

# Radio daemon WebSocket URL (for WebSocketProvider)
NEXT_PUBLIC_RADIO_DAEMON_WS_URL=ws://localhost:8081