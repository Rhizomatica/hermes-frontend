# HERMES — Environment Variables
# Copy to .env.local: cp .env.example .env.local
NEXT_PUBLIC_LOGIN_URL=/login
NEXT_PUBLIC_WS_URL=ws://localhost:8081
NEXT_PUBLIC_BASE_PATH=

# Cross-app navigation in hermes-shell. Default to path-based routing
# (co-deployed behind nginx). Override with absolute URLs for local dev:
# Shell origin for sub-apps' auth guard redirects (login lives on the shell):
NEXT_PUBLIC_SHELL_URL=http://localhost:4000
NEXT_PUBLIC_GPS_URL=http://localhost:4001
NEXT_PUBLIC_CHAT_URL=http://localhost:4002

HERMES_API_URL=http://localhost:3000/
GIT_COMMIT_HASH=dev
