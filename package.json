{
  "name": "hermes",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/hermes-shell",
    "apps/hermes-gps-final",
    "apps/hermes-chat-final",
    "packages/*"
  ],
  "scripts": {
    "dev:shell": "turbo run dev --filter=hermes-shell",
    "dev:gps": "turbo run dev --filter=hermes-gps-final",
    "dev:chat": "turbo run dev --filter=hermes-chat-final",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "turbo": "^2",
    "vitest": "^2"
  }
}
