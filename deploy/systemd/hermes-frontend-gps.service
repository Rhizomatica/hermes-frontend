[Unit]
Description=HERMES Frontend — GPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-frontend/current/gps
ExecStart=/usr/bin/node apps/hermes-gps/server.js
EnvironmentFile=/etc/hermes-frontend/gps.env
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=50
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
