# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
test-results/

# next.js
.next/
out/

# production
build/
dist/

# turborepo
.turbo/

# turbo
.turbo/

# large tile archives — download separately
*.pmtiles

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files – never commit secrets or local overrides
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# per-app node_modules and lock files
# (monorepo installs from the root; nested installs are local only)
apps/*/node_modules/
apps/*/package-lock.json
apps/*/yarn.lock
apps/*/pnpm-lock.yaml