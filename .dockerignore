# version control
.git
.gitignore

# local env — never bake secrets into images
.env*

# dev dependencies and build outputs (installed fresh inside the image)
node_modules
.next
.turbo

# large tile archives — mounted as volumes at runtime instead
*.pmtiles
*.pmtiles.sha256

# local build/release output
dist
build-output
*.tar.gz

# editor / OS noise
.DS_Store
.vscode
*.log
